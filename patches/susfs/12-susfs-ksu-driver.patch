 #include "selinux/selinux.h"
@@ -150,6 +154,10 @@ int __init kernelsu_init(void)
 
 	ksu_supercalls_init();
 
+#ifdef CONFIG_KSU_SUSFS
+	susfs_init();
+#endif
+
 	ksu_app_profile_init();
 
 	if (ksu_late_loaded) {
diff --git a/drivers/kernelsu/selinux/selinux.c b/drivers/kernelsu/selinux/selinux.c
index 258ca8196..8bbffb86c 100644
--- a/drivers/kernelsu/selinux/selinux.c
+++ b/drivers/kernelsu/selinux/selinux.c
@@ -255,6 +255,14 @@ bool is_ksu_domain(void)
     return is_task_ksu_domain(current_cred());
 }
 
+#ifdef CONFIG_KSU_SUSFS
+/* SUSFS: fs/susfs.c + fs/namespace.c call this to tell whether the caller is ksu */
+bool susfs_is_current_ksu_domain(void)
+{
+    return is_ksu_domain();
+}
+#endif
+
 bool is_zygote(const struct cred *cred)
 {
     return is_sid_match(cred, cached_zygote_sid, ZYGOTE_CONTEXT);
diff --git a/drivers/kernelsu/supercall/dispatch.c b/drivers/kernelsu/supercall/dispatch.c
index 927240415..b87ced297 100644
--- a/drivers/kernelsu/supercall/dispatch.c
